# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ

# หาได้จาก MongoDB Atlas -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ecoquest?retryWrites=true&w=majority

# ตั้งค่าเป็น string สุ่มยาวๆ สำหรับเข้ารหัส JWT
JWT_SECRET=change_this_to_a_long_random_secret

PORT=5000

# Gmail SMTP สำหรับส่งอีเมล OTP (flow ลืมรหัสผ่าน)
# ต้องเปิด 2-Step Verification ของบัญชี Gmail ก่อน แล้วสร้าง "App Password" จาก
# https://myaccount.google.com/apppasswords แล้วเอามาใส่ตรงนี้ (ห้ามใช้รหัสผ่าน Gmail จริง)
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# อีเมลที่เข้าหน้า Admin Tools ได้ (dev/QA เท่านั้น) — คั่นหลายอีเมลด้วย , เช่น a@x.com,b@y.com
# ต้องเป็นอีเมลของบัญชีจริง (ไม่ใช่ guest) ไม่ตั้งค่านี้ = ปิดหน้า Admin ทั้งหมดโดย default
ADMIN_EMAILS=
